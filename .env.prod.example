# 서버 배포 디렉터리의 .env.prod 템플릿.
# 실제 값이 든 .env.prod 는 git에 올리지 않는다(.gitignore 처리됨).
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# 여기 있는 키는 전부 "코드가 실제로 읽는 것"만 추린 것이다.
# (SLACK_WEBHOOK_URL / SLACK_APP_BASE_URL / FRONT_BASE_URL 은 어디서도 참조하지 않아 제외)

# ── 배포 대상 이미지 ────────────────────────────────────────
# deploy.sh 가 이 줄을 새 SHA 태그로 덮어쓴다. 롤백 = 이 줄을 되돌리는 것.
IMAGE=ghcr.io/applepc24/mini_cdc:latest

# ── Postgres ───────────────────────────────────────────────
# ⚠️ 기존 볼륨(mini-cdc_pgdata)에 이미 만들어진 계정이다. 여기서 바꿔도 DB는 안 바뀐다.
#    반드시 현재 값 그대로 둘 것. 바꾸려면 ALTER USER 를 먼저 실행 (docs/DEPLOY.md 참고)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mini_cdc
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/mini_cdc

# ── Kafka ──────────────────────────────────────────────────
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC=product-events
KAFKA_DLQ_TOPIC=product-events-dlq
CONSUMER_GROUP=mini-cdc-consumer-v2

# ── Auth (app/auth/jwt.py) ─────────────────────────────────
# ⚠️ 기존 운영값이 docker-compose.prod.yml 에 "dev-secret" 으로 하드코딩된 채
#    git에 공개돼 있었다(토큰 위조 가능). 반드시 교체할 것:
#       openssl rand -hex 32
#    교체하면 기존 발급 토큰이 모두 무효화되어 사용자는 재로그인이 필요하다.
JWT_SECRET_KEY=__CHANGE_ME__
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── OpenAI ─────────────────────────────────────────────────
OPENAI_API_KEY=__CHANGE_ME__
OPENAI_MODEL=gpt-4o-mini

# ── Slack OAuth ────────────────────────────────────────────
# ⚠️ 지금까지 이미지에 구워진 .env 로 동작하던 값들이다.
#    .dockerignore 로 .env 를 제외했으므로 여기 없으면 Slack 연동이 죽는다.
#    서버의 기존 .env 에서 그대로 복사할 것.
SLACK_CLIENT_ID=__CHANGE_ME__
SLACK_CLIENT_SECRET=__CHANGE_ME__
SLACK_REDIRECT_URL=https://api.stockops.site/slack/oauth/callback
WEB_BASE_URL=https://www.stockops.site
